<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <!-- CI agents provision .NET from global.json, so only the net10 runtime is
             present. Roll forward lets the net8.0 test host run there; where a real
             8.0.x runtime exists (Windows agents) it is still preferred. -->
        <RollForward Condition="'$(TargetFramework)' == 'net8.0'">Major</RollForward>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
      <PackageReference Include="NUnit" Version="4.3.2" />
      <PackageReference Include="Serilog" Version="4.2.0" />
      <PackageReference Include="Serilog.Sinks.TextWriter" Version="3.0.0" />
      <PackageReference Include="NSubstitute" Version="5.3.0" />
      <PackageReference Include="Shouldly" Version="4.3.0" />
      <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
      <PackageReference Include="TeamCity.VSTest.TestAdapter" Version="1.0.41" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\CommandLine\CommandLine.csproj" />
    </ItemGroup>

</Project>